# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://digiprospectagency.com

# Numéro WhatsApp (facultatif) : par défaut +225 05 85 79 39 50, défini dans src/lib/site.ts.
# Pour le changer : indicatif pays + numéro, sans « + » ni espaces. Laisser vide pour garder le défaut.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail professionnel affiché sur le site (laisser vide pour le masquer)
NEXT_PUBLIC_CONTACT_EMAIL=

# URL du profil ComeUp (laisser vide pour masquer le lien)
NEXT_PUBLIC_COMEUP_URL=

# Envoi du formulaire de devis via Resend (https://resend.com)
RESEND_API_KEY=
# Adresse qui reçoit les demandes de devis
CONTACT_TO_EMAIL=
# Expéditeur validé dans Resend (domaine vérifié), ex. "DigiProspect <devis@digiprospectagency.com>"
CONTACT_FROM_EMAIL=
